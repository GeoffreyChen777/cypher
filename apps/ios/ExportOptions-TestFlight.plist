<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>method</key>
    <string>app-store-connect</string>
    <!-- Local export only. Upload requires a separate, explicit decision. -->
    <key>destination</key>
    <string>export</string>
    <key>teamID</key>
    <string>999875MHT4</string>
    <!-- Manual, matching how the archive was signed. `automatic` makes
         xcodebuild resolve the profile through a signed-in Apple ID account,
         which a CI runner does not have: the export failed with "No profiles
         for 'ai.mvp-lab.cypher.ios' were found" even though the archive had
         just been signed with the profile installed beside it. The name below
         is the one ios.yml passes as PROVISIONING_PROFILE_SPECIFIER. -->
    <key>signingStyle</key>
    <string>manual</string>
    <key>signingCertificate</key>
    <string>Apple Distribution</string>
    <key>provisioningProfiles</key>
    <dict>
        <key>ai.mvp-lab.cypher.ios</key>
        <string>Cypher iOS App Store Distribution 2026</string>
    </dict>
    <key>manageAppVersionAndBuildNumber</key>
    <false/>
    <key>stripSwiftSymbols</key>
    <true/>
</dict>
</plist>
