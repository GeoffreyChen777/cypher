// Explicit Dev configuration: optimized, but never the distribution scheme.
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM = 999875MHT4
CURRENT_PROJECT_VERSION = 10
MARKETING_VERSION = 0.2.0
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = Cypher/Info.plist
PRODUCT_BUNDLE_IDENTIFIER = ai.mvp-lab.cypher.ios.dev
PRODUCT_NAME = $(TARGET_NAME)
CYPHER_DISPLAY_NAME = Cypher Dev
CYPHER_BUILD_ENVIRONMENT = development
CYPHER_URL_SCHEME = cypher-dev
CYPHER_APNS_ENVIRONMENT = development
SWIFT_VERSION = 5.0
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) CYPHER_DEVELOPMENT
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
SUPPORTS_MACCATALYST = NO
TARGETED_DEVICE_FAMILY = 1,2
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
// APNs intentionally absent. Development credentials are injected at runtime,
// never through this file or through Info.plist/build settings.
