/target
__pycache__/
**/*.rs.bk
# Local-only scratch space — holds signing/notary credentials, never commit.
/ignore/
*.pdb
.DS_Store
.env
.env.local
# wrangler's local secret file (dev access token) — never commit.
.dev.vars
node_modules
.wrangler
build/
edge/dist/

# Xcode per-user workspace state and local distribution products.
**/xcuserdata/
*.xcarchive/
*.ipa
