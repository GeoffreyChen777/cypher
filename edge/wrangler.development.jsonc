{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cypher-edge-development",
  "main": "src/development.ts",
  "compatibility_date": "2026-07-01",
  "account_id": "1489e726fc5baa8ecc7a6e1a8c8ed3f8",
  "workers_dev": true,
  "preview_urls": false,
  "rules": [{ "type": "Text", "globs": ["**/*.sh"], "fallthrough": true }],
  "alias": { "loro-crdt": "loro-crdt/base64" },
  "durable_objects": {
    "bindings": [
      { "name": "SESSION_ROOMS", "class_name": "SessionRoom" },
      { "name": "DEVICE_ROOMS", "class_name": "DeviceRoom" },
      { "name": "REGISTRY_ROOMS", "class_name": "RegistryRoom" },
      { "name": "CHAT_ROOMS", "class_name": "ChatRoom" },
      { "name": "PUSH_DEVICES", "class_name": "PushDevice" },
      { "name": "DEV_GUARD", "class_name": "DevelopmentGuard" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SessionRoom", "DeviceRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["RegistryRoom"] },
    { "tag": "v3", "new_sqlite_classes": ["ChatRoom"] },
    { "tag": "v4", "new_sqlite_classes": ["PushDevice"] },
    { "tag": "dev-v5-budget", "new_sqlite_classes": ["DevelopmentGuard"] }
  ],
  "r2_buckets": [
    { "binding": "BLOBS", "bucket_name": "cypher-development-blobs" },
    { "binding": "RELEASES", "bucket_name": "cypher-development-releases" }
  ],
  "vars": {
    "WORKOS_CLIENT_ID": "client_development_disabled",
    "AUTH_MODE": "dev-locked",
    "NOTIFICATIONS_ENABLED": "false"
  },
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false }, "traces": { "enabled": false } }
}
