{
  // Cypher v3 edge: account-scoped control/registry state and typed
  // per-conversation event logs. This is a fresh deployment contract:
  // legacy Loro/session/chat2 storage is intentionally not bound or migrated.
  "$schema": "node_modules/wrangler/config-schema.json",
  // Deployed by .github/workflows/deploy.yml on pushes to main that touch
  // edge/ (CLOUDFLARE_API_TOKEN repo secret).
  "name": "cypher-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "account_id": "1489e726fc5baa8ecc7a6e1a8c8ed3f8",
  "workers_dev": true,
  // Canonical production hostname: edge.letscypher.app (custom domain, auto-
  // provisions DNS + TLS on the letscypher.app zone). workers.dev stays
  // enabled as a fallback: cypher-edge.<account>.workers.dev keeps serving the
  // install surface (`/install.sh`) and release artifacts (`/releases/*`)
  // alongside sync/auth traffic. The landing page stays on its own
  // letscypher.app apex custom domain (apps/landing/wrangler.jsonc).
  "routes": [{ "pattern": "edge.letscypher.app", "custom_domain": true }],
  // Serve src/install.sh as a string (the /install.sh route).
  "rules": [{ "type": "Text", "globs": ["**/*.sh"], "fallthrough": true }],
  "durable_objects": {
    "bindings": [
      { "name": "SYNC3_ROOMS", "class_name": "Sync3Room" },
      { "name": "WORKSPACE3", "class_name": "WorkspaceHub" },
      { "name": "PUSH_DEVICES", "class_name": "PushDevice" }
    ]
  },
  "services": [
    { "binding": "APNS_SENDER", "service": "cypher-edge", "entrypoint": "APNsSender" }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SessionRoom", "DeviceRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["RegistryRoom"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["ChatRoom"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["PushDevice"]
    },
    {
      "tag": "v5-v3-native",
      "new_sqlite_classes": ["Sync3Room", "WorkspaceHub"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "cypher-blobs"
    },
    {
      // Release artifacts for /releases/* (curl-install + dmg downloads).
      "binding": "RELEASES",
      "bucket_name": "cypher-releases"
    }
  ],
  "vars": {
    // Cypher Production WorkOS AuthKit client id — JWTs are verified against
    // its issuer/JWKS. Set AUTH_MODE=dev locally to accept bearer==userId.
    // WORKOS_API_KEY is a wrangler secret
    // (`wrangler secret put WORKOS_API_KEY`) powering the /auth/* routes.
    "WORKOS_CLIENT_ID": "client_01M0JTKFKB6QZWHZDGYW7AN8QH",
    "AUTH_MODE": "workos",
    "SYNC3_ENABLED": "true",
    "APNS_KEY_ID": "8WP4N48QXB",
    "APNS_TEAM_ID": "999875MHT4",
    // Enable only after configuring APNS_PRIVATE_KEY (Worker secret),
    // APNS_TEAM_ID and APNS_KEY_ID and completing real-device validation.
    "NOTIFICATIONS_ENABLED": "true"
  },
  "observability": {
    "enabled": true,
    // APNs device addresses are embedded in outbound URLs; do not persist
    // outbound request tracing. Incoming routes contain no token/lease.
    "traces": { "enabled": false }
  }
}
