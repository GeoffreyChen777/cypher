{
  "version": 1,
  "description": "Whether a sent message is a slash command, shared by the desktop (crates/ui/src/slash_command.rs) and iOS (apps/ios/Cypher/Composer/SlashCommandText.swift). The message runs as a command only when, after leading whitespace, its first token (up to the first whitespace) is `/name` and `name` is a command the chat's host offers for its harness: `commands` is the host's ListCommands names (null: not loaded yet, or no chat). An empty or absent list falls back to the strict shape rule: `name` is an ASCII letter followed by ASCII letters, digits, `_`, `:` or `-`, so a path, a URL, `//`, a lone `/` or non-ASCII text never qualifies. Names match case-sensitively. `expect` is the command token as written (`/goal`), or null for an ordinary message.",
  "cases": [
    { "name": "fallback: command with an argument", "text": "/goal ship it", "commands": null, "expect": "/goal" },
    { "name": "fallback: bare command", "text": "/compact", "commands": null, "expect": "/compact" },
    { "name": "fallback: command with a switch", "text": "/fast on", "commands": null, "expect": "/fast" },
    { "name": "fallback: leading whitespace", "text": "  /mcp reconnect foo", "commands": null, "expect": "/mcp" },
    { "name": "fallback: hyphenated name", "text": "/subagent-config", "commands": null, "expect": "/subagent-config" },
    { "name": "fallback: skill name with a colon", "text": "/skill:review the diff", "commands": null, "expect": "/skill:review" },
    { "name": "fallback: underscore and digits", "text": "/export_html2 out.html", "commands": null, "expect": "/export_html2" },
    { "name": "fallback: arguments on the next line", "text": "/compact\nfocus on the api", "commands": null, "expect": "/compact" },
    { "name": "fallback: trailing whitespace", "text": "/compact  \n", "commands": null, "expect": "/compact" },
    { "name": "absolute path with a question", "text": "/Users/me/x.png 是什么", "commands": null, "expect": null },
    { "name": "lone slash then text", "text": "/ hi", "commands": null, "expect": null },
    { "name": "lone slash then CJK text", "text": "/ 这个呢", "commands": null, "expect": null },
    { "name": "lone slash", "text": "/", "commands": null, "expect": null },
    { "name": "slash then CJK", "text": "/中文", "commands": null, "expect": null },
    { "name": "short path", "text": "/tmp/a", "commands": null, "expect": null },
    { "name": "path with a trailing slash", "text": "/tmp/ 里有什么", "commands": null, "expect": null },
    { "name": "dotted name", "text": "/foo.bar", "commands": null, "expect": null },
    { "name": "double slash", "text": "//x", "commands": null, "expect": null },
    { "name": "comment-like double slash", "text": "// comment", "commands": null, "expect": null },
    { "name": "url", "text": "https://x/y", "commands": null, "expect": null },
    { "name": "scheme-relative url", "text": "//example.com/a", "commands": null, "expect": null },
    { "name": "command later in the text", "text": "hello /compact", "commands": null, "expect": null },
    { "name": "name glued to punctuation", "text": "/goal。", "commands": null, "expect": null },
    { "name": "name glued to a comma", "text": "/compact,now", "commands": null, "expect": null },
    { "name": "name starting with a digit", "text": "/2fa on", "commands": null, "expect": null },
    { "name": "name starting with a hyphen", "text": "/-x", "commands": null, "expect": null },
    { "name": "empty text", "text": "", "commands": null, "expect": null },
    { "name": "whitespace only", "text": "   ", "commands": null, "expect": null },
    { "name": "catalog: known command", "text": "/goal ship it", "commands": ["goal", "compact", "fast", "skill:review", "subagent-config"], "expect": "/goal" },
    { "name": "catalog: known name with a colon", "text": "/skill:review", "commands": ["goal", "compact", "fast", "skill:review", "subagent-config"], "expect": "/skill:review" },
    { "name": "catalog: known name with a hyphen", "text": "/subagent-config", "commands": ["goal", "compact", "fast", "skill:review", "subagent-config"], "expect": "/subagent-config" },
    { "name": "catalog: known switch", "text": "/fast on", "commands": ["goal", "compact", "fast", "skill:review", "subagent-config"], "expect": "/fast" },
    { "name": "catalog: unknown command-shaped name", "text": "/notacommand x", "commands": ["goal", "compact", "fast", "skill:review", "subagent-config"], "expect": null },
    { "name": "catalog: longer than a known name", "text": "/goals", "commands": ["goal", "compact", "fast", "skill:review", "subagent-config"], "expect": null },
    { "name": "catalog: names are case-sensitive", "text": "/Goal x", "commands": ["goal", "compact", "fast", "skill:review", "subagent-config"], "expect": null },
    { "name": "catalog: path", "text": "/Users/me/x.png 是什么", "commands": ["goal", "compact", "fast", "skill:review", "subagent-config"], "expect": null },
    { "name": "catalog: lone slash", "text": "/ 这个呢", "commands": ["goal", "compact", "fast", "skill:review", "subagent-config"], "expect": null },
    { "name": "catalog: a known name outside the shape rule still counts", "text": "/review.v2 now", "commands": ["review.v2"], "expect": "/review.v2" },
    { "name": "empty catalog: shape rule", "text": "/compact", "commands": [], "expect": "/compact" },
    { "name": "empty catalog: path", "text": "/tmp/a", "commands": [], "expect": null }
  ]
}
