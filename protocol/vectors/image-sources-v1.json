      "roots": [
        "/Users/me/proj"
      ],
      "home": "/Users/me",
      "expect": {
        "kind": "outside",
        "path": "/Users/etc/a.png"
      }
    },
    {
      "name": "tilde with a known home resolves before the roots check",
      "src": "~/a/../b/x.png",
      "cwd": "/Users/me/b",
      "roots": [
        "/Users/me/b"
      ],
      "home": "/Users/me",
      "expect": {
        "kind": "local",
        "mime": "image/png",
        "candidates": [
          {
            "root": "/Users/me/b",
            "path": "x.png"
          }
        ]
      }
    },
    {
      "name": "tilde climbing above an unknown home is outside",
      "src": "~/../x.png",
      "cwd": "~",
      "roots": [
        "~"
      ],
      "expect": {
        "kind": "outside",
        "path": "~/../x.png"
      }
    },
    {
      "name": "a relative path climbing above an unknown home is outside",
      "src": "../../x.png",
      "cwd": "~/proj",
      "roots": [
        "~/proj",
        "~"
